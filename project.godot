; Engine configuration file.
; It's best edited using the editor and not directly.
;
; Format:
;   [section]
;   param=value

config_version=5

[application]
config/name="Survive - Neon Sonar"
run/main_scene="res://scenes/game/GameRoot.tscn"
config/features=PackedStringArray("4.2")
boot_splash/show_image=false
icon="res://assets/textures/icon.svg"

[autoload]
SceneTransition="*res://scenes/ui/SceneTransition.tscn"
DataRegistry="*res://scripts/core/data_registry.gd"
FeedbackBus="*res://scripts/core/feedback_bus.gd"
TelegraphBus="*res://scripts/core/telegraph_bus.gd"
ProfileStore="*res://scripts/core/profile_store.gd"
Localization="*res://scripts/core/localization.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
